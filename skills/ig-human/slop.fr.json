  "structures": [
    {
      "id": "not-just",
      "regex": "(?i)\\bce n['’]est pas (?:seulement |juste |simplement |qu['’]une? )?[^.!?\\n]{2,60}[,.;] c['’]est\\b",
      "name": "\"Ce n'est pas juste X, c'est Y\"",
      "fix": "Dis la seule chose que tu veux dire. Supprime la moitié qui sert de décor."
    },
    {
      "id": "not-only",
      "regex": "(?i)\\bnon seulement\\b[^.!?\\n]{2,80}\\bmais (?:aussi|également|encore)\\b",
      "name": "\"Non seulement X mais aussi Y\"",
      "fix": "Deux phrases, ou garde la plus forte."
    },
    {
      "id": "isnt-about",
      "regex": "(?i)\\bil ne s['’]agit pas (?:de |d['’])[^.!?\\n]{2,60}[.,;] il s['’]agit\\b",
      "name": "\"Il ne s'agit pas de X. Il s'agit de Y.\"",
      "fix": "Commence par Y. Le retournement est le tic."
    },
    {
      "id": "the-result",
      "regex": "(?im)^\\s*(?:le résultat|le meilleur|le hic|le secret|la clé|le problème|la vérité|le truc)\\s*\\?\\s*$",
      "name": "Question rhétorique d'un mot sur sa ligne",
      "fix": "Réponds dans la phrase au lieu de mettre en scène la révélation."
    },
    {
      "id": "heres-what",
      "regex": "(?i)\\bvoici ce que (?:j['’]ai|nous avons|on a) appris\\b|\\bce que j['’]en retiens\\b",
      "name": "\"Voici ce que j'ai appris\"",
      "fix": "Dis la leçon. Saute l'annonce."
    },
    {
      "id": "triad",
      "regex": "(?i)\\b[\\wÀ-ÿ'’-]+, [\\wÀ-ÿ'’-]+ et [\\wÀ-ÿ'’-]+\\.",
      "name": "Triade (règle de trois)",
      "fix": "Deux éléments ou quatre. Trois, c'est le rythme par défaut de la machine."
    },
    {
      "id": "rocket",
      "regex": "[\\U0001F680\\U0001F525\\U0001F4A1\\u2728\\U0001F3AF]",
      "name": "Emoji fusée / feu / ampoule / étincelle / cible",
      "fix": "Un emoji max, et pas un de ces cinq."
    },
    {
      "id": "hashtag-wall",
      "regex": "(?:#[\\w]+[ \\t]*){6,}",
      "name": "Mur de hashtags (6+)",
      "fix": "5 hashtags max depuis décembre 2025, et des sujets précis."
    },
    {
      "id": "as-an-ai",
      "regex": "(?i)\\ben tant qu['’](?:ia|intelligence artificielle|assistant|modèle de langage)\\b",
      "name": "L'IA qui parle d'elle-même",
      "fix": "Supprime la phrase."
    },
    {
      "id": "in-summary",
      "regex": "(?im)^\\s*(?:en résumé|en conclusion|pour conclure|en somme|pour résumer)\\b",
      "name": "Ouverture de conclusion de dissertation",
      "fix": "Un post n'a pas besoin de paragraphe de conclusion."
    },
    {
      "id": "engagement-bait",
      "regex": "(?i)(?:\\bd['’]accord\\s*\\?|\\b(?:vous|tu) en pense[sz] quoi\\s*\\?|\\bqui d['’]autre\\b|\\bj['’]ai tort\\s*\\?|\\bvrai ou (?:pas|faux)\\s*\\?)\\s*$",
      "name": "Appât à engagement réflexe",
      "fix": "Pose une question que toi seul peux poser, sur le truc précis au-dessus."
    },
    {
      "id": "stop-scroll",
      "regex": "(?im)^\\s*(?:arr[êe]te[zs]? de scroller|stop(?:pe)? (?:ton|le) scroll|ne scrolle[zs]? pas|attends?,? ne scrolle)",
      "name": "Ouverture \"arrête de scroller\"",
